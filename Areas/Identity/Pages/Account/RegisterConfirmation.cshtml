@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "註冊確認";
}

<h1>@ViewData["Title"]</h1>
@{
    if (@Model.DisplayConfirmAccountLink)
    {
<p>
    本應用目前尚未設定實際的電子郵件發送服務，請參閱 <a href="https://aka.ms/aspaccountconf">說明文件</a> 以設定實際的電子郵件發送。
    通常系統會發送以下連結： <a id="confirm-link" href="@Model.EmailConfirmationUrl">點此確認您的帳號</a>
</p>
    }
    else
    {
<p>
        請檢查您的電子郵件並完成帳號確認。
</p>
<div class="alert alert-info">
    <i class="bi bi-envelope-open"></i> 開發測試中：若尚未設定 Gmail 應用程式密碼，驗證信會放在
    <a href="/DevMailbox" class="alert-link">開發用信箱</a>，點信中的連結即可完成驗證。
</div>
    }
}
