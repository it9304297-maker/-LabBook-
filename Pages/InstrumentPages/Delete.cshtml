@page
@model RazorPageBase.Pages.InstrumentPages.DeleteModel

@{
    ViewData["Title"] = "刪除儀器";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm border-danger">
            <div class="card-header text-bg-danger">
                <h1 class="h5 mb-0"><i class="bi bi-exclamation-triangle"></i> 確定要刪除這台儀器嗎？</h1>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Instrument.Name)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Instrument.Name)</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Instrument.AssetCode)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Instrument.AssetCode)</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Instrument.Location)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Instrument.Location)</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Instrument.HourlyRate)</dt>
                    <dd class="col-sm-8">NT$ @Html.DisplayFor(model => model.Instrument.HourlyRate)</dd>
                </dl>

                @if (Model.ReservationCount > 0)
                {
                    <div class="alert alert-warning mb-0">
                        <i class="bi bi-info-circle"></i> 此儀器已有 <strong>@Model.ReservationCount</strong> 筆預約紀錄。
                        為保留歷史資料，按下確認後會改為「停用」而不是真正刪除。
                    </div>
                }
            </div>
            <div class="card-footer bg-transparent">
                <form method="post" class="d-flex gap-2">
                    <input type="hidden" asp-for="Instrument.Id" />
                    <button type="submit" class="btn btn-danger">@(Model.ReservationCount > 0 ? "改為停用" : "確認刪除")</button>
                    <a asp-page="./Index" class="btn btn-outline-secondary">取消</a>
                </form>
            </div>
        </div>
    </div>
</div>
