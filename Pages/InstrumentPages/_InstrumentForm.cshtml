@model RazorPageBase.Models.Instrument

<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" placeholder="例：高效液相層析儀" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="AssetCode" class="form-label"></label>
        <input asp-for="AssetCode" class="form-control text-uppercase" placeholder="HPLC-001" />
        <span asp-validation-for="AssetCode" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Brand" class="form-label"></label>
        <input asp-for="Brand" class="form-control" />
        <span asp-validation-for="Brand" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Category" class="form-label"></label>
        <select asp-for="Category" asp-items="Html.GetEnumSelectList<InstrumentCategory>()" class="form-select"></select>
    </div>
    <div class="col-md-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<InstrumentStatus>()" class="form-select"></select>
    </div>
    <div class="col-md-6">
        <label asp-for="Location" class="form-label"></label>
        <input asp-for="Location" class="form-control" />
        <span asp-validation-for="Location" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="HourlyRate" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">NT$</span>
            <input asp-for="HourlyRate" class="form-control" type="number" step="1" min="0" />
        </div>
        <span asp-validation-for="HourlyRate" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="MaxHoursPerBooking" class="form-label"></label>
        <input asp-for="MaxHoursPerBooking" class="form-control" min="1" max="24" />
        <span asp-validation-for="MaxHoursPerBooking" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Custodian" class="form-label"></label>
        <input asp-for="Custodian" class="form-control" />
    </div>
    <div class="col-md-4">
        <label asp-for="PurchaseDate" class="form-label"></label>
        <input asp-for="PurchaseDate" class="form-control" />
        <span asp-validation-for="PurchaseDate" class="text-danger small"></span>
    </div>
    <div class="col-md-4 d-flex align-items-end">
        <div class="form-check form-switch mb-2">
            <input asp-for="RequiresTraining" class="form-check-input" />
            <label asp-for="RequiresTraining" class="form-check-label"></label>
        </div>
    </div>
    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>
</div>
