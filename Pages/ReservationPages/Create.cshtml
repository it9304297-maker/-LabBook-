@page
@model RazorPageBase.Pages.ReservationPages.CreateModel

@{
    ViewData["Title"] = "預約儀器";
    ViewData["InstrumentList"] = Model.InstrumentList;
    ViewData["Instruments"] = Model.AvailableInstruments;
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white">
                <h1 class="h4 mb-0"><i class="bi bi-calendar-plus text-primary"></i> 預約儀器</h1>
                <small class="text-muted">開放時段 08:00–22:00，以 30 分鐘為單位；送出後由管理員審核</small>
            </div>
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <partial name="_ReservationForm" for="Reservation" view-data="ViewData" />
                    <div class="mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-send"></i> 送出申請</button>
                        <a asp-page="Index" class="btn btn-outline-secondary">取消</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/reservation.js" asp-append-version="true"></script>
}
