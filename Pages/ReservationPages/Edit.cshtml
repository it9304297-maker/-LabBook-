@page
@model RazorPageBase.Pages.ReservationPages.EditModel

@{
    ViewData["Title"] = "修改預約";
    ViewData["InstrumentList"] = Model.InstrumentList;
    ViewData["Instruments"] = Model.AvailableInstruments;
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white">
                <h1 class="h4 mb-0"><i class="bi bi-pencil-square text-primary"></i> 修改預約</h1>
                <small class="text-muted">修改後費用會依新時段重新計算</small>
            </div>
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <input type="hidden" asp-for="Reservation.Id" />
                    <partial name="_ReservationForm" for="Reservation" view-data="ViewData" />
                    <div class="mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> 儲存</button>
                        <a asp-page="./Index" class="btn btn-outline-secondary">取消</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/reservation.js" asp-append-version="true"></script>
}
