                <label asp-for="Reservation.InstrumentId" class="control-label"></label>
                <input asp-for="Reservation.InstrumentId" class="form-control" />
                <span asp-validation-for="Reservation.InstrumentId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Reservation.Instrument" class="control-label"></label>
