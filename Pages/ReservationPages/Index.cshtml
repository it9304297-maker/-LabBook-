@page
@model RazorPageBase.Pages.ReservationPages.IndexModel

@{
    ViewData["Title"] = Model.IsAdmin ? "預約審核" : "我的預約";
    string Tab(string scope) => Model.Scope == scope ? "active" : "";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h1 class="h3 mb-0">
            <i class="bi @(Model.IsAdmin ? "bi-clipboard-check" : "bi-calendar-check") text-primary"></i>
            @ViewData["Title"]
        </h1>
        <small class="text-muted">@(Model.IsAdmin ? "所有使用者的預約申請" : "你送出的所有預約申請")</small>
    </div>
    <a asp-page="Create" class="btn btn-primary"><i class="bi bi-calendar-plus"></i> 新增預約</a>
</div>

<!-- 狀態統計 -->
<div class="row row-cols-2 row-cols-md-5 g-2 mb-3">
    @foreach (var s in Enum.GetValues<ReservationStatus>())
    {
        Model.StatusCounts.TryGetValue(s, out var c);
        <div class="col">
            <a asp-route-StatusFilter="@s" asp-route-Scope="all" class="text-decoration-none">
                <div class="card border-0 shadow-sm stat-card h-100 @(Model.StatusFilter == s ? "ring" : "")">
                    <div class="card-body py-2">
                        <span class="badge @s.BadgeClass()">@s.GetDisplayName()</span>
                        <div class="fs-4 fw-bold text-body">@c</div>
                    </div>
                </div>
            </a>
        </div>
    }
</div>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><a class="nav-link @Tab("upcoming")" asp-route-Scope="upcoming">即將使用</a></li>
    <li class="nav-item"><a class="nav-link @Tab("history")" asp-route-Scope="history">歷史紀錄</a></li>
    <li class="nav-item"><a class="nav-link @Tab("all")" asp-route-Scope="all">全部</a></li>
</ul>

<form method="get" class="row g-2 mb-3">
    <input type="hidden" asp-for="Scope" />
    <div class="col-md-6">
        <input asp-for="SearchString" class="form-control" placeholder="搜尋計畫名稱、儀器、指導教授@(Model.IsAdmin ? "、預約人" : "")" />
    </div>
    <div class="col-md-4">
        <select asp-for="StatusFilter" asp-items="Html.GetEnumSelectList<ReservationStatus>()" class="form-select">
            <option value="">全部狀態</option>
        </select>
    </div>
    <div class="col-md-2 d-grid">
        <button class="btn btn-outline-primary"><i class="bi bi-funnel"></i> 篩選</button>
    </div>
</form>

@if (!Model.Reservation.Any())
{
    <div class="alert alert-light text-center py-5 border">
        <i class="bi bi-calendar-x fs-1 d-block mb-2"></i>
        沒有符合條件的預約。<a asp-page="Create">立即預約儀器</a>
    </div>
}
else
{
    <div class="table-responsive card shadow-sm border-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>儀器</th>
                    <th>使用時段</th>
                    <th>研究計畫</th>
                    @if (Model.IsAdmin) { <th>預約人</th> }
                    <th class="text-end">費用</th>
                    <th>狀態</th>
                    <th class="text-end">操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Reservation)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@item.Instrument?.Name</div>
                            <small class="text-muted">@item.Instrument?.Location</small>
                        </td>
                        <td class="text-nowrap">
                            @item.StartTime.ToString("yyyy/MM/dd (ddd)")<br />
                            <small>@item.StartTime.ToString("HH:mm") – @item.EndTime.ToString("HH:mm")（@item.Hours 小時）</small>
                        </td>
                        <td>
                            @item.ProjectTitle
                            <br /><small class="text-muted">@item.Advisor · 樣品 @item.SampleCount</small>
                        </td>
                        @if (Model.IsAdmin) { <td><small>@item.UserEmail</small></td> }
                        <td class="text-end text-nowrap">NT$ @item.TotalFee.ToString("N0")</td>
                        <td>
                            <span class="badge @item.Status.BadgeClass()">@item.Status.GetDisplayName()</span>
                            @if (!string.IsNullOrEmpty(item.AdminNote))
                            {
                                <div><small class="text-muted" title="審核意見"><i class="bi bi-chat-left-text"></i> @item.AdminNote</small></div>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            @if (Model.IsAdmin && item.Status == ReservationStatus.Pending)
                            {
                                <form method="post" asp-page-handler="Approve" asp-route-id="@item.Id"
                                      asp-route-Scope="@Model.Scope" class="d-inline">
                                    <button class="btn btn-sm btn-success" title="核准"><i class="bi bi-check-lg"></i></button>
                                </form>
                                <button class="btn btn-sm btn-outline-danger" title="退回"
                                        data-bs-toggle="modal" data-bs-target="#rejectModal" data-id="@item.Id">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            }
                            @if (Model.IsAdmin && item.Status == ReservationStatus.Approved)
                            {
                                <form method="post" asp-page-handler="Complete" asp-route-id="@item.Id"
                                      asp-route-Scope="@Model.Scope" class="d-inline">
                                    <button class="btn btn-sm btn-outline-primary" title="標記完成"><i class="bi bi-flag"></i></button>
                                </form>
                            }
                            <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="詳細"><i class="bi bi-eye"></i></a>
                            @if (item.Status == ReservationStatus.Pending && item.StartTime > DateTime.Now)
                            {
                                <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="修改"><i class="bi bi-pencil"></i></a>
                            }
                            @if ((item.Status == ReservationStatus.Pending || item.Status == ReservationStatus.Approved) && item.StartTime > DateTime.Now
                                 || Model.IsAdmin)
                            {
                                <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="取消/刪除"><i class="bi bi-trash"></i></a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Model.IsAdmin)
{
    <!-- 退回原因 Modal -->
    <div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post" asp-page-handler="Reject" asp-route-Scope="@Model.Scope" class="modal-content" id="rejectForm">
                <div class="modal-header">
                    <h5 class="modal-title">退回預約</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="rejectId" />
                    <label class="form-label">退回原因</label>
                    <textarea name="note" class="form-control" rows="3" maxlength="200" placeholder="例：該時段儀器保養、未完成教育訓練…"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-danger">確認退回</button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.getElementById('rejectModal')?.addEventListener('show.bs.modal', e => {
            document.getElementById('rejectId').value = e.relatedTarget.getAttribute('data-id');
        });
    </script>
}
