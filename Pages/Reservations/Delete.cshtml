@page
@model RazorPageBase.Pages.Reservations.DeleteModel

@{
    ViewData["Title"] = "取消預約";
    var r = Model.Reservation;
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm border-danger">
            <div class="card-header text-bg-danger">
                <h1 class="h5 mb-0"><i class="bi bi-exclamation-triangle"></i> @(Model.CanCancel ? "確定要取消這筆預約嗎？" : "刪除預約紀錄")</h1>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Reservation.Instrument)</dt>
                    <dd class="col-sm-8">@r.Instrument?.Name</dd>
                    <dt class="col-sm-4">使用時段</dt>
                    <dd class="col-sm-8">@r.StartTime.ToString("yyyy/MM/dd HH:mm") – @r.EndTime.ToString("HH:mm")</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Reservation.ProjectTitle)</dt>
                    <dd class="col-sm-8">@r.ProjectTitle</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Reservation.UserEmail)</dt>
                    <dd class="col-sm-8">@r.UserEmail</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Reservation.Status)</dt>
                    <dd class="col-sm-8"><span class="badge @r.Status.BadgeClass()">@r.Status.GetDisplayName()</span></dd>
                </dl>
            </div>
            <div class="card-footer bg-transparent">
                <form method="post" class="d-flex flex-wrap gap-2">
                    @if (Model.CanCancel)
                    {
                        <button type="submit" asp-page-handler="Cancel" asp-route-id="@r.Id" class="btn btn-danger">
                            <i class="bi bi-x-circle"></i> 確認取消預約
                        </button>
                    }
                    @if (Model.IsAdmin)
                    {
                        <button type="submit" asp-page-handler="Delete" asp-route-id="@r.Id" class="btn btn-outline-danger">
                            <i class="bi bi-trash"></i> 永久刪除紀錄（管理員）
                        </button>
                    }
                    <a asp-page="./Index" class="btn btn-outline-secondary">返回</a>
                </form>
            </div>
        </div>
    </div>
</div>
