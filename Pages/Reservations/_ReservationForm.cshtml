@model RazorPageBase.Models.Reservation
@{
    var instrumentList = (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewData["InstrumentList"]!;
    var instruments = (List<Instrument>)ViewData["Instruments"]!;
}

<div class="row g-3">
    <div class="col-12">
        <label asp-for="InstrumentId" class="form-label"></label>
        <select asp-for="InstrumentId" asp-items="instrumentList" class="form-select" id="instrumentSelect">
            <option value="0">-- 請選擇儀器 --</option>
        </select>
        <span asp-validation-for="InstrumentId" class="text-danger small"></span>
        <div id="instrumentInfo" class="form-text"></div>
    </div>
    <div class="col-md-6">
        <label asp-for="StartTime" class="form-label"></label>
        <input asp-for="StartTime" class="form-control" step="1800" id="startInput" />
        <span asp-validation-for="StartTime" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="EndTime" class="form-label"></label>
        <input asp-for="EndTime" class="form-control" step="1800" id="endInput" />
        <span asp-validation-for="EndTime" class="text-danger small"></span>
    </div>
    <div class="col-md-8">
        <label asp-for="ProjectTitle" class="form-label"></label>
        <input asp-for="ProjectTitle" class="form-control" placeholder="例：奈米觸媒表面形貌鑑定" />
        <span asp-validation-for="ProjectTitle" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Advisor" class="form-label"></label>
        <input asp-for="Advisor" class="form-control" />
        <span asp-validation-for="Advisor" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="SampleCount" class="form-label"></label>
        <input asp-for="SampleCount" class="form-control" min="1" max="200" />
        <span asp-validation-for="SampleCount" class="text-danger small"></span>
    </div>
    <div class="col-md-8">
        <label class="form-label">預估費用</label>
        <div class="fee-box" id="feeBox">請選擇儀器與時段</div>
    </div>
    <div class="col-12">
        <label asp-for="Purpose" class="form-label"></label>
        <textarea asp-for="Purpose" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Purpose" class="text-danger small"></span>
    </div>
</div>

<script>
    window.labInstruments = @Json.Serialize(instruments.Select(i => new {
        id = i.Id, rate = i.HourlyRate, max = i.MaxHoursPerBooking,
        location = i.Location, training = i.RequiresTraining
    }));
</script>
