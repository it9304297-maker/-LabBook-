@using Microsoft.AspNetCore.Identity
@using RazorPageBase.Data

 

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

 



<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <span class="nav-link">
                <i class="bi bi-person-circle"></i> @User.Identity?.Name
            </span>
        </li>

        <li class="nav-item">
            <a class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index">
                👤會員
            </a>
        </li>

        @if (User.IsInRole("Admin"))
        {

            <li class="nav-item">
                <a class="nav-link" asp-area="Identity" asp-page="/Account/Manage/UI/Users"> Identity管理</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-page="/Admin/Index">
                    管理後台
                </a>
            </li>
        }

        <li class="nav-item">
            <form asp-area="Identity"
                  asp-page="/Account/Logout"
                  method="post">
                <button type="submit" class="nav-link btn btn-link">
                    登出
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link"
               asp-area="Identity"
               asp-page="/Account/Register">
                註冊
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link"
               asp-area="Identity"
               asp-page="/Account/Login">
                登入
            </a>
        </li>
    }
</ul>





